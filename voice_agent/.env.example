# LiveKit Cloud project credentials
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Twilio Elastic SIP Trunk — termination SIP domain.
# HOSTNAME ONLY, no "sip:" prefix. Example: my-trunk.pstn.twilio.com
TWILIO_SIP_TERMINATION_DOMAIN=

# Twilio termination credential list username / password
TWILIO_SIP_AUTH_USERNAME=
TWILIO_SIP_AUTH_PASSWORD=

# US local Twilio number associated with the trunk, full E.164 (+1...)
TWILIO_PHONE_NUMBER=

# Destination mobile, full E.164 (+91...)
DESTINATION_PHONE_NUMBER=

# Populated after running ./create_trunk.sh — paste the ST_... id here
LIVEKIT_OUTBOUND_TRUNK_ID=

# ── Opik observability (comet.com/signup — the free tier is enough) ──────────
# Comet → account settings → API keys
OPIK_API_KEY=
# Your Comet WORKSPACE, which is normally your username — NOT a project name.
# A project name here fails with "401 User not allowed to access workspace!".
# Check yours:
#   curl -H "Authorization: $OPIK_API_KEY" https://www.comet.com/api/rest/v2/workspaces
OPIK_WORKSPACE=
# Any name. The project is created on first write.
OPIK_PROJECT_NAME=
# false disables all Opik export; the agent runs identically without it.
OPIK_ENABLED=true

# ── Optional ────────────────────────────────────────────────────────────────
# false skips the post-call LLM analysis (saves inference while iterating).
# ANALYSIS_ENABLED=true
# true starts a LiveKit egress per call. Bills per call; a console session
# already records locally via `lk agent console --record`.
# CALL_RECORDING_ENABLED=false
# Which patient a CONSOLE session calls. Phone calls take it from dispatch.
# PATIENT_ID=P001
